# Copy to `.env` and fill in (never commit `.env`).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# Optional: Sentry browser DSN for error reporting (omit in local dev if unused)
VITE_SENTRY_DSN=
# Optional: show "Admin inbox" link on Feedback page (same values as Supabase ADMIN_USER_ID / ADMIN_EMAIL)
VITE_ADMIN_USER_ID=
VITE_ADMIN_EMAIL=
